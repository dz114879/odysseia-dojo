---
import '../styles/public.css';
import { publicSourceRevisionUrl } from '../lib/public-build-config.mjs';
import SiteClosureGuard from './SiteClosureGuard.astro';
import DMeowTheme from './DMeowTheme.astro';

interface Props {
	title: string;
	description: string;
	minimal?: boolean;
}

const { title, description, minimal = false } = Astro.props;
const canonicalOrigin = import.meta.env.PUBLIC_CANONICAL_URL;
const sourceRevisionUrl = publicSourceRevisionUrl(import.meta.env) ?? 'https://github.com/dz114879/odysseia-dojo';

let canonicalUrl: string | undefined;
if (canonicalOrigin) {
	try {
		canonicalUrl = new URL(Astro.url.pathname, canonicalOrigin).toString();
	} catch {
		canonicalUrl = undefined;
	}
}
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
		<title>{title}</title>
		<SiteClosureGuard />
		<DMeowTheme />
	</head>
	<body>
		{!minimal && (
			<>
				<a class="skip-link" href="#main-content">
					跳转到主要内容
				</a>
				<header class="public-header">
					<a class="public-brand" data-dojo-brand href="/" aria-label="类脑 Odysseia 首页">
						类脑 <span>Odysseia</span>
					</a>
					<nav aria-label="公开导航">
						<a href="/#privacy">隐私说明</a>
						<a href="/login">登录</a>
					</nav>
				</header>
			</>
		)}
		<div id="main-content" tabindex="-1">
			<slot />
		</div>
		{!minimal && (
			<footer class="public-footer">
				<p>Made by KKTsN with 💖</p>
				<a
					class="footer-github-link"
					href={sourceRevisionUrl}
					target="_blank"
					rel="noopener noreferrer"
					aria-label="在 GitHub 查看项目源码（新标签页）"
				>
					GitHub <span aria-hidden="true">↗</span>
				</a>
			</footer>
		)}
	</body>
</html>
