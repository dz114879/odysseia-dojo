---
const { category, isOutdated, title } = Astro.locals.starlightRoute.entry.data;
const categoryLabel = category === 'tutorial' ? '基础教程' : '扩展阅读';
---

<div class="dojo-doc-heading" data-content-category={category}>
	<div class="dojo-doc-meta">
		<p class="dojo-doc-category">{categoryLabel}</p>
		<button
			class="dojo-copy-markdown"
			data-copy-markdown
			data-dojo-ui
			data-pagefind-ignore
			type="button"
			hidden
		>
			<svg class="dojo-copy-icon dojo-copy-icon-copy" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
				<rect x="5.5" y="2.5" width="8" height="10" rx="1.5" stroke="currentColor" stroke-width="1.25" />
				<path d="M3.5 5.5H3A1.5 1.5 0 0 0 1.5 7v6A1.5 1.5 0 0 0 3 14.5h6a1.5 1.5 0 0 0 1.5-1.5v-.5" stroke="currentColor" stroke-width="1.25" />
			</svg>
			<svg class="dojo-copy-icon dojo-copy-icon-check" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
				<path d="M3.25 8.5 6.5 11.75 12.75 4.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
			</svg>
			<span data-copy-markdown-label>复制 Markdown</span>
		</button>
		<span class="sr-only" data-copy-markdown-status data-dojo-ui data-pagefind-ignore role="status" aria-live="polite"></span>
	</div>
	<h1 id="_top">{title}</h1>
	{isOutdated && (
		<aside class="dojo-outdated-notice" data-outdated-notice role="note">
			本文部分内容可能已经过时。
		</aside>
	)}
</div>

<style>
	@layer starlight.core {
		.dojo-doc-meta {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			justify-content: space-between;
			gap: 0.75rem;
		}

		.dojo-doc-heading h1 {
			margin-top: 0.25rem;
			font-size: var(--sl-text-h1);
			line-height: var(--sl-line-height-headings);
			font-weight: 600;
			color: var(--sl-color-white);
		}

		.dojo-doc-category {
			margin: 0;
			color: var(--sl-color-text-accent);
			font-size: var(--sl-text-sm);
			font-weight: 700;
		}

		.dojo-copy-markdown {
			display: inline-flex;
			align-items: center;
			gap: 0.4rem;
			border: 1px solid var(--sl-color-hairline-light);
			border-radius: 99px;
			padding: 0.28rem 0.72rem;
			background: transparent;
			color: var(--sl-color-text);
			font-family: var(--sl-font);
			font-size: 12px;
			line-height: 1.4;
			cursor: pointer;
			transition:
				border-color 150ms ease,
				background-color 150ms ease,
				color 150ms ease;
		}

		.dojo-copy-markdown[hidden] {
			display: none;
		}

		.dojo-copy-markdown:hover {
			border-color: var(--sl-color-accent);
			background: var(--sl-color-accent-low);
			color: var(--sl-color-accent-high);
		}

		.dojo-copy-markdown[data-copy-state='copied'] {
			border-color: var(--sl-color-accent);
			background: var(--sl-color-accent-low);
			color: var(--sl-color-accent-high);
		}

		.dojo-copy-markdown[data-copy-state='error'] {
			border-color: var(--sl-color-orange);
			color: var(--sl-color-orange);
		}

		.dojo-copy-icon {
			flex: none;
		}

		.dojo-copy-icon-check,
		.dojo-copy-markdown[data-copy-state='copied'] .dojo-copy-icon-copy {
			display: none;
		}

		.dojo-copy-markdown[data-copy-state='copied'] .dojo-copy-icon-check {
			display: block;
		}

		.dojo-outdated-notice {
			margin-top: 1rem;
			border-inline-start: 0.25rem solid var(--sl-color-orange);
			padding: 0.75rem 1rem;
			background: var(--sl-color-orange-low);
			color: var(--sl-color-text);
		}

		@media (prefers-reduced-motion: reduce) {
			.dojo-copy-markdown {
				transition: none;
			}
		}
	}
</style>
